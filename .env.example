# ============================================================================
# LeadSpot — variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs réelles.
# Aucune de ces valeurs ne doit être commitée.
# ============================================================================

# --- Supabase (Auth + Postgres) — https://supabase.com — free tier, sans CB
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Geoapify Places API — https://www.geoapify.com — free tier, sans CB
GEOAPIFY_API_KEY=

# --- Upstash Redis (cache de recherche 7 jours) — https://upstash.com — free tier, sans CB
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (cron : keepalive + rescan hebdo) — free tier, sans CB
QSTASH_TOKEN=
# Signing keys (Upstash console > QStash > Signing Keys) : optionnelles en
# local, FORTEMENT recommandées en production pour vérifier que les appels
# à /api/keepalive et /api/cron/rescan viennent bien de QStash.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Resend (emails d'alerte + prospection) — https://resend.com — free tier, sans CB
RESEND_API_KEY=
# Expéditeur des emails de prospection. Valeur par défaut : la sandbox gratuite
# (onboarding@resend.dev). Après vérification d'un domaine dans Resend, mettez
# par ex. "Votre Agence <contact@votre-domaine.fr>" pour recevoir les réponses.
RESEND_FROM_EMAIL=

# --- Fournisseur de tuiles carto (PAS de tiles OSM directes en prod)
# MapTiler free tier avec clé : https://www.maptiler.com/cloud/pricing/
NEXT_PUBLIC_MAP_TILES_API_KEY=

# --- Notifications push (Web Push, VAPID) — sans service tiers, 100 % gratuit
# Générer les clés : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "mailto:" ou URL de contact utilisée pour identifier l'expéditeur
VAPID_SUBJECT=mailto:contact@exemple.fr

# --- Quota utilisateur
FREE_TIER_MONTHLY_SEARCH_LIMIT=10

# --- URL publique de l'app (utilisée pour enregistrer les schedules QStash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
